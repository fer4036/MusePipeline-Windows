FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=10000

WORKDIR /app

COPY requirements-cloud.txt ./
COPY muse_hrc ./muse_hrc
COPY muse_web ./muse_web

RUN pip install --no-cache-dir -r requirements-cloud.txt \
    && pip install --no-cache-dir ./muse_hrc ./muse_web

USER 65532:65532

EXPOSE 10000

CMD ["python", "-m", "muse_web.cloud_app"]
